# --- InsForge backend (BaaS: auth + Postgres + realtime) ---
# Public/anon key is safe for the browser (RLS-gated). Get values from:
#   npx @insforge/cli secrets get INSFORGE_BASE_URL / ANON_KEY
NEXT_PUBLIC_INSFORGE_BASE_URL=https://ts4hxi45.us-east.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here

# Server-only admin key (ik_..., bypasses RLS) — NEVER expose to the browser.
# INSFORGE_API_KEY=ik_xxxxx

# --- Luna agent (Phase 2) ---
# When set, /api/chat proxies to the agent (which owns prompts/memory/persistence).
# Local dev: http://127.0.0.1:8000 (python main.py in agent/)
# Prod: https://luna-agent.<aca-domain>
LUNA_AGENT_URL=
LUNA_AGENT_MODEL=gpt-5.6-luna

# --- LLM (Azure AI Foundry OpenAI-compatible) — direct fallback when no agent URL ---
AZURE_OPENAI_BASE_URL=https://datumm-agent-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_MODEL=gpt-5.6-luna
